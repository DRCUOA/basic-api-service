# Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Environment
# Options: development, test, production
# Controls logging behavior and database access restrictions
NODE_ENV=development

# Server Configuration
# Port on which the API server will listen
# Default: 3000
PORT=3000

# Database Configuration
# REQUIRED: Database name
# Must be explicitly set (no default)
# For test environment, database name must include 'test' in the name
# Development: basic_api
# Test: basic_api_test
DB_NAME=basic_api

# REQUIRED: Database username
# Must be explicitly set (no default)
# Development options: Rich, postgres
# Test options: basic_api_test_user, nzwa_test_user_1
DB_USER=Rich

# Database password
# Optional: Can be null/undefined for databases without password
# Leave empty if your PostgreSQL users don't require passwords
DB_PASSWORD=

# Database host
# Default: localhost
DB_HOST=localhost

# Database port
# Default: 5432
DB_PORT=5432

# ============================================================================
# Test Environment Configuration
# ============================================================================
# For running tests, create a .env.test file with:
#
# NODE_ENV=test
# DB_NAME=basic_api_test
# DB_USER=basic_api_test_user
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
#
# Note: The test environment requires DB_NAME to include 'test' in the name
# Available test databases: basic_api_test
# Available test users: basic_api_test_user, nzwa_test_user_1
